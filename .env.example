# PostgreSQL — valori sigure pentru dezvoltare locală; schimbă-le într-un
# mediu real (producție/staging), nu le lăsa pe cele implicite.
POSTGRES_USER=electro
POSTGRES_PASSWORD=electro_dev_password
POSTGRES_DB=electro_proiect
# Folosită de backend pentru a se conecta la Postgres; "db" e numele
# serviciului din docker-compose.yml (rezolvat prin rețeaua internă Docker).
# Pentru dezvoltare locală fără Docker, înlocuiește "db" cu "localhost".
DATABASE_URL=postgresql+psycopg2://electro:electro_dev_password@db:5432/electro_proiect

# JWT — secretul de mai jos e doar pentru dezvoltare. Generează unul nou și
# ține-l secret (variabilă de mediu la deploy, niciodată în git) pentru orice
# mediu accesibil din afara mașinii tale.
JWT_SECRET=change_me_dev_secret_do_not_use_in_prod
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440

# Frontend — URL-ul la care Next.js găsește API-ul FastAPI din browser
# (client-side fetch), nu din containerul frontend însuși.
NEXT_PUBLIC_API_URL=http://localhost:8000
